{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/renderer-ts",
    "rootDir": "src",
    "types": ["node"],
    "module": "None",
    "resolveJsonModule": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
